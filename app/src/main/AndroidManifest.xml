<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker"
        tools:targetApi="31">
        <activity
            android:name=".Activity.CategoryActivity"
            android:exported="false"
            android:label="@string/title_activity_category"
            android:theme="@style/Theme.ExpenseTracker" />
        <activity
            android:name=".Activity.StatisticsActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.ManageBankAccountActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.ExpenseCategoryActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.IncomeCategoryActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.AddCategoryActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.AddActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.SettingComposeActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.PaymentMethodsComposeActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExpenseTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>