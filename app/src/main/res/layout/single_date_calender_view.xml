<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calender_day_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/linearLayout_singleItem_singleDateViewHolder"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/relativeLayout_circleBackground_singleDateViewHolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"

            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/textView_date_singleDateViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/manropesemibold"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/textColor"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout_backgroundExpense_singleDateViewHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="2dp"
            android:layout_marginTop="5dp"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:paddingBottom="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/transaction_single_rectangle_background"
            android:backgroundTint="@color/grey_background"
            >

            <TextView
                android:id="@+id/textView_expenseAmount_singleDateViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/manropesemibold"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textSize="12sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout_backgroundIncome_singleDateViewHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="2dp"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            android:layout_marginEnd="2dp"
            android:background="@drawable/transaction_single_rectangle_background"
            android:backgroundTint="@color/grey_background"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            >

            <TextView
                android:id="@+id/textView_incomeAmount_singleDateViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/manropebold"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@color/green"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>