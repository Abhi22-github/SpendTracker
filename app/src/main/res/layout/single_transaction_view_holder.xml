<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="3dp"
    android:paddingEnd="10dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linearLayout_dateDay_transactionViewHolder"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_day_transactionViewHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manropesemibold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <RelativeLayout
                android:id="@+id/relativeLayout_circleBackground_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/black"
                android:paddingStart="5dp"
                android:paddingTop="1sp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/textView_date_transactionViewHolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manropesemibold"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </RelativeLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout_singleEntry_transactionViewHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <RelativeLayout
                android:id="@+id/textView_icon_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1a1a73e8"
                android:layout_alignParentStart="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:alpha="1"
                    android:src="@drawable/baseline_fastfood_24"
                    app:tint="@color/blue" />
            </RelativeLayout>

            <TextView
                android:id="@+id/textView_note_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toRightOf="@id/textView_icon_transactionViewHolder"
                android:fontFamily="@font/manropesemibold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView_amount_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/googlesansmedium"
                android:textSize="16sp" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>