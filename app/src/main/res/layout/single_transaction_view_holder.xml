<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="4dp"
    android:paddingStart="@dimen/margin_12"
    android:paddingEnd="@dimen/margin_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/linearLayout_entry_transactionViewHolder"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/linearLayout_dateDay_transactionViewHolder"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_day_transactionViewHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manropesemibold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <RelativeLayout
                android:id="@+id/relativeLayout_circleBackground_transactionViewHolder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/black"
                android:padding="@dimen/padding_4">

                <TextView
                    android:id="@+id/textView_date_transactionViewHolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/manropesemibold"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </RelativeLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout_singleEntry_transactionViewHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/padding_4"
            android:padding="@dimen/margin_12">

            <RelativeLayout
                android:id="@+id/textView_icon_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#1a1a73e8"
                android:layout_alignParentStart="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:alpha="1"
                    android:src="@drawable/baseline_fastfood_24"
                    app:tint="@color/blue" />
            </RelativeLayout>

            <TextView
                android:id="@+id/textView_note_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_16"
                android:layout_toStartOf="@+id/textView_amount_transactionViewHolder"
                android:layout_toEndOf="@id/textView_icon_transactionViewHolder"
                android:fontFamily="@font/manropesemibold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textView_amount_transactionViewHolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/googlesansmedium"
                android:textSize="16sp" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>