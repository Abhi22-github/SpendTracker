<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.ExpenseTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">#1a73e8</item>
    </style>

    <style name="dayNameText">
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/manropesemibold</item>
        <item name="android:textSize">12sp</item>
    </style>


    <style name="menuItemStyle">
        <item name="fontFamily">@font/manropesemibold</item>
        <item name="android:textSize">14.sp</item>
    </style>

    <style name="toolbarTitleStyle">
        <item name="fontFamily">@font/manropesemibold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorControlActivated">@color/blue</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalenderViewDateCustomText" >
        <item name="android:textColor">@drawable/calender_date_selector</item>
    </style>


    <style name="chipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <!-- text related property does not directly apply on chips -->
        <item name="android:textAppearance">@style/chipText</item>
        <item name="chipBackgroundColor">@color/chip_background_color_state_list</item>
        <item name="android:textColor">@color/chip_text_color_state_list</item>
        <item name="chipStartPadding">10dp</item>
        <item name="rippleColor">@null</item>
        <item name="chipStrokeColor">@color/chip_stroke_color_state_list</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="ButtonStyle" parent="Widget.Material3.Button.OutlinedButton">

    </style>


    <style name="toggleButtonStyle" parent="Widget.Material3.Button">
        <!--        <item name="backgroundTint">@color/toggle_group_button_background_color_state</item>-->
        <item name="android:textColor">@color/black</item>
        <item name="rippleColor">@color/grey_background</item>
        <item name="cornerRadius">10dp</item>
        <item name="fontFamily">@font/manropesemibold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="chipText" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="fontFamily">@font/manropemedium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

</resources>